{
  "manifest_version": 3,
  "name": "Bookmark Agent",
  "version": "2.0.0",
  "description": "Read, search and manage Chrome bookmarks locally from your coding agents.",
  "minimum_chrome_version": "120",
  "permissions": [
    "bookmarks",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bookmark Agent"
  },
  "options_page": "options.html",
  "key": ""
}
